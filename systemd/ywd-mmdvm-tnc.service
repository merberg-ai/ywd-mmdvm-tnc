[Unit]
Description=YWD-MMDVM-TNC dedicated AX.25 modem service
Documentation=https://github.com/merberg-ai/ywd-mmdvm-tnc
After=local-fs.target network.target
Conflicts=MMDVMHost.service mmdvmhost.service ywd-mmdvmhost.service ywd-hotspot-mmdvmhost.service ywd-1278.service
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 /opt/ywd-mmdvm-tnc/source/vendor/ywd-1278/firmware/hat_control.py application-release --config /etc/ywd-mmdvm-tnc/config.toml
ExecStart=/opt/ywd-mmdvm-tnc/venv/bin/ywd-tncd --config /etc/ywd-mmdvm-tnc/config.toml
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=20
RuntimeDirectory=ywd-mmdvm-tnc
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
